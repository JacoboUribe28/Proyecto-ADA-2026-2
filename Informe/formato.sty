% ---------------------------------------------------------------- títulos de sección
\RequirePackage{titlesec}
\titleformat{\section}{\sffamily\Large\bfseries\color{verdeazul}}
  {\colorbox{verdeazul}{\textcolor{white}{\,\thesection\,}}}{0.6em}{}[\vspace{-0.4em}\textcolor{verdeazul}{\rule{\linewidth}{0.6pt}}]
