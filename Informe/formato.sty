\fancyhead[R]{\sffamily\small\color{gris}Jacobo Uribe Montoya · 36921}
\fancyfoot[C]{\sffamily\small\color{verdeazul}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{verdeazul}\leaders\hrule height \headrulewidth\hfill}}

% ---------------------------------------------------------------- cajas de teoremas
\RequirePackage[most]{tcolorbox}
\theoremstyle{definition}
\newtheorem{definicion}{Definición}[section]
\newtheorem{teorema}[definicion]{Teorema}
\newtheorem{lema}[definicion]{Lema}
\newtheorem{proposicion}[definicion]{Proposición}
\newtheorem{observacion}[definicion]{Observación}
\tcolorboxenvironment{definicion}{enhanced,breakable,colback=verdeclaro,colframe=verdeclaro,
  borderline west={3pt}{0pt}{verdeazul},arc=0pt,boxrule=0pt,left=8pt,right=8pt,top=4pt,bottom=4pt}
\tcolorboxenvironment{teorema}{enhanced,breakable,colback=white,colframe=verdeazul,
  arc=2pt,boxrule=0.8pt,left=8pt,right=8pt,top=4pt,bottom=4pt}
\tcolorboxenvironment{lema}{enhanced,breakable,colback=white,colframe=verdeazul!60,
  arc=2pt,boxrule=0.6pt,left=8pt,right=8pt,top=4pt,bottom=4pt}
\tcolorboxenvironment{proposicion}{enhanced,breakable,colback=white,colframe=verdeazul,
  arc=2pt,boxrule=0.8pt,left=8pt,right=8pt,top=4pt,bottom=4pt}
\tcolorboxenvironment{observacion}{enhanced,breakable,colback=ambarclaro,colframe=ambarclaro,
  borderline west={3pt}{0pt}{ambar},arc=0pt,boxrule=0pt,left=8pt,right=8pt,top=4pt,bottom=4pt}
\renewcommand{\qedsymbol}{\textcolor{verdeazul}{$\blacksquare$}}

